<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <!-- Измените параметры подключения под свой PostgreSQL -->
    <add name="ShoeStore"
         connectionString="Host=localhost;Port=5432;Database=storess;Username=padmin;Password=1"
         providerName="Npgsql" />
  </connectionStrings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>
