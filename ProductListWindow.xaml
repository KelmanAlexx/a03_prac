<Window x:Class="ShoeStore.ProductListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:ShoeStore.Models"
        Icon="Images/app.ico"
        Title="Товары — Магазин электроники"
        Height="760" Width="1180"
        MinHeight="620" MinWidth="900"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource AdditionalBackgroundBrush}" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Source="Images/Logo.png" Width="58" Height="58" Stretch="Uniform" Margin="0,0,14,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Магазин электроники" FontSize="23" FontWeight="Bold"/>
                    <TextBlock Text="Каталог товаров"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock x:Name="UserNameTextBlock" FontWeight="Bold" TextAlignment="Right"/>
                    <TextBlock x:Name="RoleTextBlock" Foreground="#555555" TextAlignment="Right"/>
                    <Button Content="Выйти" Click="LogoutButton_Click" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="10,8">
            <WrapPanel x:Name="FilterPanel" VerticalAlignment="Center">
                <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="4"/>
                <TextBox x:Name="SearchTextBox" Width="220" TextChanged="SearchTextBox_TextChanged"/>
                <TextBlock Text="Сортировка:" VerticalAlignment="Center" Margin="12,4,4,4"/>
                <ComboBox x:Name="SortComboBox" Width="190" SelectedIndex="0"
                          SelectionChanged="FilterControl_SelectionChanged">
                    <ComboBoxItem Content="Без сортировки"/>
                    <ComboBoxItem Content="Остаток: по возрастанию"/>
                    <ComboBoxItem Content="Остаток: по убыванию"/>
                </ComboBox>
                <TextBlock Text="Поставщик:" VerticalAlignment="Center" Margin="12,4,4,4"/>
                <ComboBox x:Name="SupplierComboBox" Width="180"
                          DisplayMemberPath="Name" SelectedValuePath="Id"
                          SelectionChanged="FilterControl_SelectionChanged"/>
            </WrapPanel>
            <WrapPanel>
                <Button x:Name="AddProductButton" Content="Добавить товар" Click="AddProductButton_Click"/>
                <Button x:Name="OrdersButton" Content="Заказы" Click="OrdersButton_Click"/>
                <TextBlock x:Name="CountTextBlock" VerticalAlignment="Center" Margin="12,4"/>
            </WrapPanel>
        </StackPanel>

        <ListBox x:Name="ProductsListBox" Grid.Row="2" Margin="10"
                 BorderThickness="0" Background="Transparent"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionChanged="ProductsListBox_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type models:Product}">
                    <Border BorderBrush="#777777" BorderThickness="1" Margin="3" Padding="8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="White"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBigDiscount}" Value="True">
                                        <Setter Property="Background" Value="#2E8B57"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                        <Setter Property="Background" Value="#FF8080"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsOutOfStock}" Value="True">
                                        <Setter Property="Background" Value="LightBlue"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="145"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" BorderBrush="Black" BorderThickness="1" Margin="2" Padding="3">
                                <Image Source="{Binding Photo}" Height="112" Width="135" Stretch="Uniform"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,2">
                                <TextBlock Text="{Binding CategoryName, StringFormat={}{0} | }" FontWeight="Bold"/>
                                <TextBlock Text="{Binding ProductName}" FontSize="19" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Article, StringFormat=Артикул: {0}}"/>
                                <TextBlock Text="{Binding Description, StringFormat=Описание: {0}}" TextWrapping="Wrap" Margin="0,4"/>
                                <TextBlock Text="{Binding ManufacturerName, StringFormat=Производитель: {0}}"/>
                                <TextBlock Text="{Binding SupplierName, StringFormat=Поставщик: {0}}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <TextBlock Text="Цена: " VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Price, StringFormat={}{0:N0} руб.}"
                                               Foreground="Red" TextDecorations="Strikethrough" Margin="0,0,8,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasDiscount}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding FinalPrice, StringFormat={}{0:N2} руб.}" Foreground="Black" FontWeight="Bold"/>
                                </StackPanel>
                                <TextBlock Text="{Binding UnitName, StringFormat=Единица измерения: {0}}"/>
                                <TextBlock Text="{Binding StockQuantity, StringFormat=Количество на складе: {0}}"/>
                            </StackPanel>
                            <Border Grid.Column="2" BorderBrush="Black" BorderThickness="2" Margin="2">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Действующая скидка" TextAlignment="Center" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Discount, StringFormat={}{0}%}"
                                               FontSize="27" FontWeight="Bold" TextAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
