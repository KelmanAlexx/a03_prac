<Window x:Class="ShoeStore.ProductEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Images/app.ico"
        Title="Товар — Магазин обуви"
        Height="700" Width="820"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="285"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,16,0">
            <TextBlock Text="Фото товара" FontWeight="Bold" Margin="4"/>
            <Border BorderBrush="Black" BorderThickness="1" Height="205" Padding="4">
                <Image x:Name="PhotoImage" Stretch="Uniform"/>
            </Border>
            <Button x:Name="ChoosePhotoButton" Content="Выбрать фото..." Click="ChoosePhotoButton_Click"/>
            <TextBlock Text="PNG или JPG. При сохранении фото будет уменьшено до 300×200."
                       Foreground="Gray" TextWrapping="Wrap" Margin="4"/>
            <TextBlock Text="ID / артикул" FontWeight="Bold" Margin="4,14,4,0"/>
            <TextBox x:Name="ArticleTextBox"/>
            <TextBlock x:Name="IdInfoTextBlock" Foreground="Gray" TextWrapping="Wrap" Margin="4"/>
        </StackPanel>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Наименование"/>
                <TextBox x:Name="NameTextBox"/>
                <TextBlock Text="Категория"/>
                <ComboBox x:Name="CategoryComboBox" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                <TextBlock Text="Описание"/>
                <TextBox x:Name="DescriptionTextBox" Height="65" AcceptsReturn="True" TextWrapping="Wrap"/>
                <TextBlock Text="Производитель"/>
                <ComboBox x:Name="ManufacturerComboBox" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                <TextBlock Text="Поставщик"/>
                <ComboBox x:Name="SupplierComboBox" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                <TextBlock Text="Цена (руб.)"/>
                <TextBox x:Name="PriceTextBox"/>
                <TextBlock Text="Единица измерения"/>
                <ComboBox x:Name="UnitComboBox" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                <TextBlock Text="Количество на складе"/>
                <TextBox x:Name="StockTextBox"/>
                <TextBlock Text="Скидка (%)"/>
                <TextBox x:Name="DiscountTextBox"/>
                <WrapPanel HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button x:Name="DeleteButton" Content="Удалить" Background="#FF8080" Click="DeleteButton_Click"/>
                    <Button Content="Назад" Click="BackButton_Click" Background="#D2F6E7"/>
                    <Button x:Name="SaveButton" Content="Сохранить" Click="SaveButton_Click"/>
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
