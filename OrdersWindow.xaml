<Window x:Class="ShoeStore.OrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Images/app.ico"
        Title="Заказы — Магазин обуви"
        Height="650" Width="1050"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource AdditionalBackgroundBrush}" Padding="12">
            <DockPanel>
                <TextBlock Text="Заказы" FontSize="23" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock x:Name="RoleInfoTextBlock" DockPanel.Dock="Right"
                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>

        <DataGrid x:Name="OrdersDataGrid" Grid.Row="1" Margin="0,12"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionUnit="FullRow"
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№" Binding="{Binding OrderId}" Width="55"/>
                <DataGridTextColumn Header="Дата заказа" Binding="{Binding OrderDate, StringFormat=dd.MM.yyyy}" Width="100"/>
                <DataGridTextColumn Header="Дата доставки" Binding="{Binding DeliveryDate, StringFormat=dd.MM.yyyy}" Width="110"/>
                <DataGridTextColumn Header="Клиент" Binding="{Binding ClientName}" Width="170"/>
                <DataGridTextColumn Header="Пункт выдачи" Binding="{Binding PickupAddress}" Width="190"/>
                <DataGridTextColumn Header="Код" Binding="{Binding ReceiveCode}" Width="65"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding StatusName}" Width="95"/>
                <DataGridTextColumn Header="Состав заказа" Binding="{Binding ItemsText}" Width="*"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding TotalAmount, StringFormat={}{0:N2}}" Width="95"/>
            </DataGrid.Columns>
        </DataGrid>

        <WrapPanel Grid.Row="2" HorizontalAlignment="Right">
            <Button x:Name="CreateOrderButton" Content="Создать заказ" Click="CreateOrderButton_Click"/>
            <Button x:Name="EditOrderButton" Content="Редактировать" Click="EditOrderButton_Click"/>
            <Button x:Name="DeleteOrderButton" Content="Удалить" Background="#FF8080" Click="DeleteOrderButton_Click"/>
            <Button Content="Назад" Background="#D2F6E7" Click="BackButton_Click"/>
        </WrapPanel>
    </Grid>
</Window>
