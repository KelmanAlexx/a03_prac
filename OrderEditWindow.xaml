<Window x:Class="ShoeStore.OrderEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Images/app.ico"
        Title="Заказ — Магазин обуви"
        Height="650" Width="820"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Loaded="Window_Loaded">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource AdditionalBackgroundBrush}" Padding="10">
            <TextBlock x:Name="HeaderTextBlock" Text="Оформление заказа" FontSize="21" FontWeight="Bold"/>
        </Border>

        <Grid Grid.Row="1" Margin="0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="4">
                <TextBlock Text="Клиент"/>
                <ComboBox x:Name="ClientComboBox" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                <TextBlock Text="Дата заказа"/>
                <TextBox x:Name="OrderDateTextBox" IsReadOnly="True"/>
                <TextBlock Text="Пункт выдачи"/>
                <ComboBox x:Name="PickupComboBox" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                <TextBlock Text="Дата доставки"/>
                <DatePicker x:Name="DeliveryDatePicker" Margin="4"/>
                <TextBlock Text="Статус"/>
                <ComboBox x:Name="StatusComboBox" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                <TextBlock Text="Код получения" Margin="4,12,4,0"/>
                <TextBlock x:Name="CodeTextBlock" Margin="4" Foreground="Gray"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="4">
                <StackPanel x:Name="AddLinePanel">
                    <TextBlock Text="Товар"/>
                    <ComboBox x:Name="ProductComboBox" DisplayMemberPath="ProductName" SelectedValuePath="Article"/>
                    <TextBlock Text="Количество"/>
                    <TextBox x:Name="QuantityTextBox" Text="1"/>
                    <Button Content="Добавить в заказ" Click="AddLineButton_Click"/>
                    <Button Content="Удалить позицию" Click="RemoveLineButton_Click" Background="#FF8080"/>
                </StackPanel>
                <TextBlock Text="Состав заказа" FontWeight="Bold" Margin="4,12,4,4"/>
                <DataGrid x:Name="LinesDataGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                          IsReadOnly="True" Height="250">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Артикул" Binding="{Binding Article}" Width="85"/>
                        <DataGridTextColumn Header="Товар" Binding="{Binding ProductName}" Width="*"/>
                        <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="65"/>
                        <DataGridTextColumn Header="Цена" Binding="{Binding UnitPrice, StringFormat={}{0:N2}}" Width="80"/>
                        <DataGridTextColumn Header="Сумма" Binding="{Binding Sum, StringFormat={}{0:N2}}" Width="85"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="TotalTextBlock" FontSize="18" FontWeight="Bold"
                           HorizontalAlignment="Right" Margin="4,8"/>
            </StackPanel>
        </Grid>

        <WrapPanel Grid.Row="2" HorizontalAlignment="Right">
            <Button Content="Назад" Background="#D2F6E7" Click="BackButton_Click"/>
            <Button Content="Сохранить" Click="SaveButton_Click"/>
        </WrapPanel>
    </Grid>
</Window>
